# Optional overrides. Prefer: feishu setup --name 你的名字
# which writes ~/.feishu-partner/config.json (never commit that file).
#
# export FEISHU_PARTNER_USER_OPEN_ID="ou_your_user"
# export FEISHU_PARTNER_BOT_OPEN_ID="ou_your_bot"
# export FEISHU_PARTNER_P2P_CHAT_ID="oc_your_p2p_with_bot"
# export FEISHU_PARTNER_USER_NAMES="张三"
# export FEISHU_PARTNER_WEEKLY_QUERY="张三 周报"
# export FEISHU_PARTNER_CONFIG="$HOME/.feishu-partner/config.json"
# export FEISHU_PARTNER_NO_LLM=1
# export LARK_CLI="/absolute/path/to/lark-cli"
# export HERMES_BIN="/absolute/path/to/hermes"
